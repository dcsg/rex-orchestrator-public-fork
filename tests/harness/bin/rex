#!/bin/bash
# Bash-only additions to the fake CLI; the existing Python scenario model stays unchanged.
# whoami knobs: FAKE_REX_WHOAMI_RC and FAKE_REX_WHOAMI_OUT (literal JSON, or malformed data for refusal tests).
set -euo pipefail
if [ "$#" -eq 2 ] && [ "$1" = whoami ] && [ "$2" = --json ]; then
  printf 'whoami --json\n' >>"$FAKE_REX_DIR/whoami.log"
  [ "${FAKE_REX_WHOAMI_RC:-0}" -eq 0 ] || exit "$FAKE_REX_WHOAMI_RC"
  if [ "${FAKE_REX_WHOAMI_OUT+x}" = x ]; then
    printf '%s\n' "$FAKE_REX_WHOAMI_OUT"
  else
    jq -nc --arg block "${REX_BLOCK:-}" '{session_id:"session:fake", block_id:$block}'
  fi
  exit 0
fi
exec python3 -I -S "$(dirname "$0")/rex-model.py" "$@"
